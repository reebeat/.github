{
  "name": "reebeat-org",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint",
    "ready": "bun run check && bun run test && bun run model:check && bun run generate:check && bun run knip && bun run cpd && bun run secrets",
    "check": "vp check",
    "test": "vp run -r --no-cache test",
    "model:check": "bun tools/intent/src/cli.ts check",
    "generate": "bun tools/intent/src/cli.ts generate",
    "generate:check": "bun tools/intent/src/cli.ts generate --check",
    "tracker:refresh": "bun tools/intent/src/cli.ts tracker-refresh",
    "sources:verify": "bun tools/intent/src/cli.ts verify-sources",
    "status:diff": "bun tools/intent/src/cli.ts status-diff",
    "knip": "knip",
    "cpd": "jscpd --config .jscpd.json .",
    "secrets": "gitleaks git --config .gitleaks.toml --redact",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/tsgo": "catalog:",
    "@phibkro/oxlint-effect-plugin": "0.2.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxlint-plugin-complexity": "4.0.0",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "typescript": "7.0.2",
    "@types/node": "^26.6.5",
    "effect": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@effect/tsgo": "0.63.0",
    "yaml": "2.8.1"
  }
}
